generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  loginId       String    @unique
  email         String    @unique
  name          String
  role          Role      @default(EMPLOYEE)
  phone         String?
  profilePhoto  String?
  department    String?
  managerId     String?
  manager       User?     @relation("ManagerEmployee", fields: [managerId], references: [id])
  subordinates  User[]    @relation("ManagerEmployee")
  location      String?
  empCode       String?
  dateOfJoining DateTime?
  passwordHash  String
  isFirstLogin    Boolean   @default(true)
  faceDescriptor  Json?
  createdAt       DateTime  @default(now())

  resume           Resume?
  privateInfo      PrivateInfo?
  salaryInfo       SalaryInfo?
  attendance       Attendance[]
  leaveAllocations EmployeeLeaveAllocation[]
  timeOffRequests  TimeOffRequest[]
  payslips         Payslip[]

  @@index([createdAt])
  @@index([managerId])
  @@index([name])
  @@index([department])
}

enum Role {
  ADMIN
  EMPLOYEE
  HR_OFFICER
  PAYROLL_OFFICER
}

model Resume {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  about          String?
  loveAboutJob   String?
  interests      String?
  skills         String[]
  certifications String[]
}

model PrivateInfo {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  dob           DateTime?
  address       String?
  nationality   String?
  personalEmail String?
  gender        String?
  maritalStatus String?
  accountNumber String?
  bankName      String?
  ifscCode      String?
  panNo         String?
  uanNo         String?
  dateOfJoining DateTime?
}

model SalaryInfo {
  id                 String @id @default(uuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id])
  monthWage          Float  @default(0)
  yearlyWage         Float  @default(0)
  workingDaysPerWeek Int    @default(5)
  breakTime          Float  @default(1)
  wageType           String @default("MONTHLY")
  basicSalary        Float  @default(0)
  hra                Float  @default(0)
  standardAllowance  Float  @default(0)
  performanceBonus   Float  @default(0)
  lta                Float  @default(0)
  fixedAllowance     Float  @default(0)
  employeePF         Float  @default(0)
  employerPF         Float  @default(0)
  professionalTax    Float  @default(200)
  tdsDeduction       Float  @default(0)
}

model Attendance {
  id       String           @id @default(uuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id])
  date     DateTime         @default(now())
  checkIn  DateTime?
  checkOut DateTime?
  status   AttendanceStatus @default(ABSENT)

  @@index([userId, date])
  @@index([date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
}

model TimeOffRequest {
  id                     String      @id @default(uuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id])
  leaveType              LeaveType
  startDate              DateTime
  endDate                DateTime
  reason                 String?
  status                 LeaveStatus @default(PENDING)
  medicalCertificateName String?
  medicalCertificateType String?
  medicalCertificateData String?
  createdAt              DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([userId, startDate, endDate])
  @@index([status, startDate, endDate])
}

enum LeaveType {
  PAID
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payrun {
  id         String       @id @default(cuid())
  month      Int
  year       Int
  status     PayrunStatus @default(GENERATED)
  createdBy  String       @default("system")
  approvedBy String?
  approvedAt DateTime?
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  payslips   Payslip[]

  @@index([year, month, createdAt])
}

model Payslip {
  id                   String        @id @default(cuid())
  payrunId             String
  payrun               Payrun        @relation(fields: [payrunId], references: [id])
  employeeId           String        @map("userId")
  employee             User          @relation(fields: [employeeId], references: [id])
  totalWorkingDays     Float         @default(0)
  attendanceDays       Float         @default(0)
  paidLeaveDays        Float         @default(0)
  basicSalary          Float
  hra                  Float
  standardAllowance    Float
  performanceBonus     Float
  lta                  Float
  fixedAllowance       Float
  grossPay             Float
  employeePF           Float
  employerPF           Float
  professionalTax      Float
  tdsDeduction         Float         @default(0)
  netPay               Float
  employerCost         Float         @default(0)
  baseSalary           Float         @default(0)
  totalSalary          Float         @default(0)
  unpaidLeaveDays      Int           @default(0)
  unpaidLeaveDeduction Float         @default(0)
  status               PayslipStatus @default(GENERATED)
  createdAt            DateTime      @default(now())

  @@index([employeeId, createdAt])
  @@index([payrunId, createdAt])
}

model EmployeeLeaveAllocation {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year                Int
  paidLeavesAllocated Int      @default(20)
  sickLeavesAllocated Int      @default(5)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([employeeId, year])
}

model PublicHoliday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
}

enum PayrunStatus {
  DRAFT
  GENERATED
  REVIEWED
  APPROVED
  PAID
  LOCKED
}

enum PayslipStatus {
  GENERATED
  VALIDATED
  PAID
}

model Settings {
  id          String  @id @default("singleton")
  companyName String  @default("EmPay")
  companyLogo String?
}
